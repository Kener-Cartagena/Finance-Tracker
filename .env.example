# Variables para docker compose. Copia a .env (no se versiona) y rellena.
#   cp .env.example .env

# Puerto del host donde se publica la app (nginx)
APP_PORT=8080

# Django
# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto
DEBUG=False
# Debe incluir localhost: lo usa el healthcheck interno del contenedor
ALLOWED_HOSTS=localhost,127.0.0.1
# Origen(es) con esquema y puerto desde donde se abre la app (login del admin)
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Solo si el frontend se sirve desde OTRO dominio que el backend (separados por comas)
CORS_EXTRA_ORIGINS=

# MySQL
DB_NAME=finance_tracker
DB_USER=finance
DB_PASSWORD=cambia-esto
DB_ROOT_PASSWORD=cambia-esto-tambien

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# 1 = el backend aplica migraciones al arrancar
DJANGO_MIGRATE=1

# Imágenes a usar (por defecto se construyen en local). Para desplegar lo
# publicado por CI, p. ej.:
#   BACKEND_IMAGE=ghcr.io/<owner>/finance-tracker-backend:latest
#   FRONTEND_IMAGE=ghcr.io/<owner>/finance-tracker-frontend:latest
