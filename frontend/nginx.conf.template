# Plantilla procesada por envsubst al arrancar la imagen oficial de nginx.
# ${BACKEND_URL} se define en el Dockerfile (por defecto http://backend:8000).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    # API, admin de Django y sus estáticos -> backend (mismo origen, sin CORS)
    location ~ ^/(api|admin|static)/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Assets de Vite con hash en el nombre: caché larga
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier otra ruta la resuelve React Router
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
